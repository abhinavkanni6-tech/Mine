# Example environment variables for the Abhinav Discord Tool

# Admin username and password used to create the initial admin user on first run
# Change these before running in any semi-public environment.
ADMIN_USER=admin
ADMIN_PASS=admin

# Session secret for express-session (use a long random string in production)
SESSION_SECRET=replace_with_a_long_random_secret

# Port the Node server will listen on
PORT=3000

# Optional: command to run Python on your host. Default: python3 on Unix, python on Windows
# If your hosting platform exposes Python as `python` instead of `python3`, set:
# PYTHON_CMD=python
PYTHON_CMD=python3
